# DATABASE_URL: Neon PostgreSQL connection string.
# Jika DB dihubungkan lewat Vercel Marketplace (Neon Native Integration),
# variabel ini otomatis diisi oleh Vercel — biasanya tidak perlu diisi manual.
# Untuk pengembangan lokal, ambil dari Neon Console:
# Dashboard -> Connection Details -> Connection String
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=""
